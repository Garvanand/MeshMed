# --------------------------------------------------------
# MESHMED ENVIRONMENT CONFIGURATION (.env.example)
# --------------------------------------------------------

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxx

# AgentOS Shared Infrastructure
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql+asyncpg://agentos:agentos_password@postgres:5432/agentos_shared
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# MeshMed Security (CRITICAL)
# Must be a 32-byte url-safe base64-encoded key
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=your_generated_fernet_key_here

# AgentOS APIs
AGENTOS_INTERNAL_SERVICE_TOKEN=your_secure_agentos_internal_token_here

# External APIs
WHATSAPP_API_TOKEN=your_whatsapp_token_here
OPENFDA_API_KEY=your_openfda_api_key_here

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=production
